          "clue": "사원증 기록이 남지 않는 출입 방식을 알고 있다"
        },
        {
          "type": "evidenceGet",
          "id": "ev_clue_guard",
          "category": "character"
        },
        {
          "type": "noteAdd",
          "id": "note_cctv"
        },
        {
          "type": "flagSet",
