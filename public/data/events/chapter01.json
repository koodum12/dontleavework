      "type": "dialogue",
      "speaker": "사랑",
      "speakerId": "sarang",
      "text": "퇴근. 오른쪽 끝 엘리베이터를 타면 오늘이 끝난다.",
      "effects": [
        {
          "type": "flagSet",
          "key": "chapter1_done",
          "value": true
        }
      ]
    }
