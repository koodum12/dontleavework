      "next": "chapter1_end"
    },
    {
      "id": "cctv_skip",
      "type": "dialogue",
      "speaker": "사랑",
      "speakerId": "sarang",
      "text": "오늘은… 확인할수록 더 이상한 것만 보일 것 같아. 찝찝하지만 집으로 돌아간다.",
      "effects": [
        {
          "type": "noteAdd",
          "id": "note_no_cctv"
        },
        {
          "type": "flagSet",
          "key": "checked_cctv",
